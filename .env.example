# Entorno informativo, se expone en /health
ENVIRONMENT=local

# Ruta del archivo SQLite (relativa al directorio de trabajo del proceso)
TALLER_DB_PATH=taller.db

# Si está en true y la base está vacía al arrancar, carga datos de ejemplo (repuestos demo)
AUTO_SEED=true

# Orígenes CORS adicionales separados por coma (localhost siempre está permitido)
# Ejemplo prod: https://spacecraft-system.web.app,https://spacecraft-taller.web.app
ALLOWED_ORIGINS=

# Clave que Java (spacecraftSystem) debe mandar en el header X-Internal-Api-Key
# para poder crear reparaciones. Sin esta clave configurada, el endpoint interno
# rechaza TODO (a diferencia del resto del demo, este canal siempre exige clave).
TALLER_INTERNAL_API_KEY=changeme-internal-key

# Backend de BankIn al que este servicio le cobra los presupuestos aprobados
BANKIN_API_BASE=http://localhost:8000
# Clave opcional que BankIn puede exigir (X-Api-Key). Si BankIn no tiene
# EXTERNAL_API_KEY configurada, se puede dejar vacía.
BANKIN_API_KEY=

TALLER_INTERNAL_API_KEY=FOgU5yp3QNasKZTtkMW8_J_5ph5NqcYG5b3yfftF_IE
BANKIN_API_BASE=http://localhost:8000